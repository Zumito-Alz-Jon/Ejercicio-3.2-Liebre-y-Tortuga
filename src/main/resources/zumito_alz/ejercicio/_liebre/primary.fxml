<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="zumito_alz.ejercicio._liebre.PrimaryController">
   <children>
      <Label text="La Liebre y la Tortuga" />
      <Button fx:id="btnIniciar" onAction="#btnIniciar_click" text="¡Iniciar Carrera!" />
      <Label fx:id="lblLiebre" text="La Liebre:" />
      <ProgressBar fx:id="pbLiebre" prefWidth="200.0" progress="0.0" />
      <Label fx:id="lblTortuga" text="La Tortuga:" />
      <ProgressBar fx:id="pbTortuga" prefWidth="200.0" progress="0.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
